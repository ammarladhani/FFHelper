# Copy this file to .env and fill in real values. .env is gitignored -
# config.py is not, so nothing secret should ever go directly in config.py.
#
# Pull fresh SWID / espn_s2 from your browser: open fantasy.espn.com while
# logged in, open dev tools -> Network tab -> any request to
# fantasy.espn.com -> Cookies. These are session credentials for YOUR ESPN
# account - treat them like a password. They also expire periodically and
# will need refreshing.

ESPN_SWID_MY_LEAGUE={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2_MY_LEAGUE=paste-the-espn_s2-cookie-value-here
