# Copy this file to .env and fill in real values. .env is gitignored -
# config.py is not, so nothing secret should ever go directly in config.py.
#
# Pull fresh SWID / espn_s2 from your browser: open fantasy.espn.com while
# logged in, open dev tools -> Network tab -> any request to
# fantasy.espn.com -> Cookies. These are session credentials for YOUR ESPN
# account - treat them like a password. They also expire periodically and
# will need refreshing.

ESPN_SWID_MY_LEAGUE={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2_MY_LEAGUE=paste-the-espn_s2-cookie-value-here

# Yahoo needs OAuth2, not a cookie - run `python get_yahoo_token.py` once
# (after registering an app at https://developer.yahoo.com/apps/, see the
# README's Yahoo setup section) and it'll print these three values for you.
# One Yahoo account's credentials cover every Yahoo league you're in on
# that account - you don't need a separate set per league.

YAHOO_CLIENT_ID=paste-your-yahoo-app-client-id-here
YAHOO_CLIENT_SECRET=paste-your-yahoo-app-client-secret-here
YAHOO_REFRESH_TOKEN=paste-the-refresh-token-get_yahoo_token.py-printed-here
